-- ===== ESP (пул рисунков) =====
local ESPDrawings = {}
local function GetESPColor(role)
    if role == "Murderer" then return Color3.new(1,0,0)
    elseif role == "Sheriff" then return Color3.new(0,0.6,1)
    else return Color3.new(0.8,0.8,0.8)
    end
end

local function UpdateESP()
    for _, d in pairs(ESPDrawings) do d.Visible = false end
    if not Enabled.ESP then return end
    local idx = 1
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not head or not root then continue end
        local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end
        local role = "Innocent"
        local ls = plr:FindFirstChild("leaderstats")
        if ls and ls:FindFirstChild("Role") then role = ls.Role.Value end
        local dist = (Camera.CFrame.Position - head.Position).Magnitude
        local color = GetESPColor(role)
        local scale = math.clamp(1 / (dist * 0.05), 0.3, 1.5)

        -- Box
        if Enabled.Box then
            local d = ESPDrawings["box"..idx] or Drawing.new("Square")
            d.Visible = true
            d.Color = color
            d.Thickness = 1.5
            d.Size = Vector2.new(1500/(dist+50), 2500/(dist+50)) * scale
            d.Position = Vector2.new(pos.X - d.Size.X/2, pos.Y - d.Size.Y/2)
            ESPDrawings["box"..idx] = d
        end

        -- Name
        if Enabled.Name then
            local d = ESPDrawings["name"..idx] or Drawing.new("Text")
            d.Visible = true
            d.Text = plr.Name
            d.Color = Color3.new(1,1,1)
            d.Size = 13
            d.Position = Vector2.new(pos.X, pos.Y - 60)
            d.Center = true
            ESPDrawings["name"..idx] = d
        end

        -- Role
        if Enabled.Role then
            local d = ESPDrawings["role"..idx] or Drawing.new("Text")
            d.Visible = true
            d.Text = "["..role.."]"
            d.Color = color
            d.Size = 13
            d.Position = Vector2.new(pos.X, pos.Y - 45)
            d.Center = true
            ESPDrawings["role"..idx] = d
        end

        -- Distance
        if Enabled.Distance then
            local d = ESPDrawings["dist"..idx] or Drawing.new("Text")
            d.Visible = true
            d.Text = math.floor(dist).."m"
            d.Color = Color3.new(1,1,1)
            d.Size = 13
            d.Position = Vector2.new(pos.X, pos.Y - 30)
            d.Center = true
            ESPDrawings["dist"..idx] = d
        end

        -- Snapline
        if Enabled.Line then
            local d = ESPDrawings["line"..idx] or Drawing.new("Line")
            d.Visible = true
            d.Color = color
            d.Thickness = 1
            d.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            d.To = Vector2.new(pos.X, pos.Y)
            ESPDrawings["line"..idx] = d
        end

        idx += 1
    end
    -- Скрываем неиспользуемые рисунки
    for key, d in pairs(ESPDrawings) do
        if tonumber(string.match(key, "%d+")) and idx <= tonumber(string.match(key, "%d+")) then
            d.Visible = false
        end
    end
end

