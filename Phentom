-- ESP визуализация через Drawing
local drawings = {}
local function clearESP()
    for _, d in pairs(drawings) do
        pcall(function() d:Remove() end)
    end
    table.clear(drawings)
end

RunService.RenderStepped:Connect(function()
    clearESP()
    if not espEnabled then return end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char or not char:FindFirstChild("Head") then continue end
        local head = char.Head
        local root = char:FindFirstChild("HumanoidRootPart")
        local pos, visible = Camera:WorldToViewportPoint(head.Position)
        if not visible then continue end

        local role = getRole(plr)
        local dist = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position - head.Position).Magnitude

        -- Box
        if boxEsp then
            local box = Drawing.new("Square")
            box.Visible = true
            box.Color = role == "Murderer" and Color3.new(1,0,0) or role == "Sheriff" and Color3.new(0,0,1) or Color3.new(1,1,1)
            box.Thickness = 1.5
            box.Size = Vector2.new(2000/(dist+50), 4000/(dist+50))
            box.Position = Vector2.new(pos.X - box.Size.X/2, pos.Y - box.Size.Y/2)
            table.insert(drawings, box)
        end

        -- Name
        if nameEsp then
            local text = Drawing.new("Text")
            text.Visible = true
            text.Text = plr.Name
            text.Color = Color3.new(1,1,1)
            text.Size = 14
            text.Position = Vector2.new(pos.X, pos.Y - 50)
            text.Center = true
            table.insert(drawings, text)
        end

        -- Role
        if roleEsp then
            local text = Drawing.new("Text")
            text.Visible = true
            text.Text = "["..role.."]"
            text.Color = role == "Murderer" and Color3.new(1,0.3,0.3) or role == "Sheriff" and Color3.new(0.3,0.5,1) or Color3.new(0.8,0.8,0.8)
            text.Size = 13
            text.Position = Vector2.new(pos.X, pos.Y - 35)
            text.Center = true
            table.insert(drawings, text)
        end

        -- Distance
        if distEsp then
            local text = Drawing.new("Text")
            text.Visible = true
            text.Text = math.floor(dist).." studs"
            text.Color = Color3.new(1,1,1)
            text.Size = 13
            text.Position = Vector2.new(pos.X, pos.Y - 20)
            text.Center = true
            table.insert(drawings, text)
        end
    end
end)

