local function AddToggle(page, y, text, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -20, 0, 28)
    frame.Position = UDim2.new(0, 10, 0, y)
    frame.BackgroundTransparency = 1
