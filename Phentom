-- ===== Aimbot / Silent Aim =====
local function GetClosestPlayerInFOV()
    local closest = nil
    local minAngle = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local head = plr.Character and plr.Character:FindFirstChild("Head")
        if head then
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local delta = Vector2.new(screenPos.X - mousePos.X, screenPos.Y - mousePos.Y)
                local angle = delta.Magnitude
                if angle < minAngle and angle <= Enabled.AimbotFOV then
                    minAngle = angle
                    closest = head
                end
            end
        end
    end
    return closest
end

-- Silent Aim реализуется через подмену метода Camera:WorldToViewportPoint? Более просто: во время выстрела подменяем CFrame оружия.
-- Для Auto Shoot + Aimbot нужно активировать Gun с наведением.
-- Получаем Gun из рюкзака, устанавливаем его CFrame на камеру + смещение.
-- Лучше использовать RemoteEvent: MainEvent с аргументом "Shoot" или что-то подобное.
local ShootRemote = ReplicatedStorage:FindFirstChild("Shoot") or ReplicatedStorage:FindFirstChild("MainEvent")
if not ShootRemote then
    for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
        if rem:IsA("RemoteEvent") and (rem.Name == "Shoot" or rem.Name == "Fire") then
            ShootRemote = rem
            break
        end
    end
end

RunService.Stepped:Connect(function()
    if Enabled.AutoShoot and LocalPlayer.Character then
        local role = "Innocent"
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        if ls and ls:FindFirstChild("Role") then role = ls.Role.Value end
        if role == "Sheriff" then
            local target = GetClosestPlayerInFOV()
            if target then
                if Enabled.SilentAim then
                    -- Подмена направления камеры
                    local oldCFrame = Camera.CFrame
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
                    if ShootRemote then
                        ShootRemote:FireServer()
                    else
                        local gun = LocalPlayer.Backpack:FindFirstChild("Gun") or LocalPlayer.Character:FindFirstChild("Gun")
                        if gun and gun:IsA("Tool") then
                            gun:Activate()
                        end
                    end
                    Camera.CFrame = oldCFrame
                else
                    -- Обычный aim + shoot
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
                    if ShootRemote then
                        ShootRemote:FireServer()
                    else
                        local gun = LocalPlayer.Backpack:FindFirstChild("Gun") or LocalPlayer.Character:FindFirstChild("Gun")
                        if gun and gun:IsA("Tool") then
                            gun:Activate()
                        end
                    end
                end
            end
        end
    end
    if Enabled.Aimbot and not Enabled.AutoShoot then
        local target = GetClosestPlayerInFOV()
        if target then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
        end
    end
end)

