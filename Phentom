-- === Рабочие циклы ===
-- Auto Farm
task.spawn(function()
    while task.wait(0.2) do
        if autoFarm and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local root = LocalPlayer.Character.HumanoidRootPart
            local nearest, nearDist = nil, math.huge
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj.Name == "Coin" or obj.Name == "Loot" then
                    local pos = obj.Position
                    local dist = (root.Position - pos).Magnitude
                    if dist < nearDist then
                        nearDist = dist
                        nearest = obj
                    end
                end
            end
            if nearest then
                root.CFrame = CFrame.new(nearest.Position + Vector3.new(0,3,0))
                task.wait(0.05)
            end
        end
    end
end)

-- Auto Shoot (для шерифа)
task.spawn(function()
    while task.wait(0.15) do
        if autoShoot and getRole(LocalPlayer) == "Sheriff" then
            local mur = getMurderer()
            if mur and mur.Character and mur.Character:FindFirstChild("Head") then
                local gun = LocalPlayer.Backpack:FindFirstChild("Gun") or LocalPlayer.Character:FindFirstChild("Gun")
                if gun and gun:IsA("Tool") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.lookAt(LocalPlayer.Character.HumanoidRootPart.Position, mur.Character.Head.Position)
                    task.wait(0.05)
                    gun:Activate()
                    -- Альтернатива через Remote
                    -- local rem = game.ReplicatedStorage:FindFirstChild("ShootEvent") or game.ReplicatedStorage:FindFirstChild("Fire")
                    -- if rem then rem:FireServer() end
                end
            end
        end
    end
end)

