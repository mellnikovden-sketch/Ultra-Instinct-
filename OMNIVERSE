function _G.Menu:AddToggle(text, callback, category)
    local parent = self.Categories[category]
    if not parent then
        parent = self:AddCategory(category)
    end
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -10, 0, 35)
    container.Position = UDim2.new(0, 5, 0, #parent:GetChildren() * 35 + 5)
    container.BackgroundTransparency = 1
    container.Parent = parent
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = COLORS.text
    label.TextSize = 12
    label.Font = Enum.Font.Jura
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container
    
    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0, 55, 0, 25)
    toggle.Position = UDim2.new(1, -60, 0.5, -12.5)
    toggle.BackgroundColor3 = COLORS.bgSecondary
    toggle.Text = "OFF"
    toggle.TextColor3 = COLORS.textDim
    toggle.TextSize = 11
    toggle.Font = Enum.Font.Jura
    toggle.Parent = container
    
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(1, 0)
    toggleCorner.Parent = toggle
    
    local state = false
    
    toggle.Activated:Connect(function()
        state = not state
        if state then
            toggle.BackgroundColor3 = COLORS.textBright
            toggle.Text = "ON"
            toggle.TextColor3 = COLORS.bg
        else
            toggle.BackgroundColor3 = COLORS.bgSecondary
            toggle.Text = "OFF"
            toggle.TextColor3 = COLORS.textDim
        end
        if callback then callback(state) end
    end)
    
    UpdateContainerSize(parent)
    return container
end

