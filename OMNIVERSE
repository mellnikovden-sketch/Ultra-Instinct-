local function AddColorPicker(menu, category)
    local parent = menu.Categories[category]
    if not parent then
        parent = menu:AddCategory(category)
    end
    
    -- Заголовок секции
    local header = Instance.new("TextLabel")
    header.Size = UDim2.new(1, -10, 0, 30)
    header.Position = UDim2.new(0, 5, 0, #parent:GetChildren() * 40 + 5)
    header.BackgroundTransparency = 1
    header.Text = "🎨 ВЫБОР ЦВЕТА GUI"
    header.TextColor3 = Color3.fromRGB(180, 150, 255)
    header.TextSize = 14
    header.Font = Enum.Font.Jura
    header.TextXAlignment = Enum.TextXAlignment.Center
    header.Parent = parent
    
    -- Контейнер для цветов со СКРОЛЛИНГОМ
    local colorContainer = Instance.new("ScrollingFrame")
    colorContainer.Size = UDim2.new(1, -10, 0, 180)
    colorContainer.Position = UDim2.new(0, 5, 0, #parent:GetChildren() * 40 + 5)
    colorContainer.BackgroundColor3 = Color3.fromRGB(15, 12, 25)
    colorContainer.BackgroundTransparency = 0.3
    colorContainer.BorderSizePixel = 0
    colorContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    colorContainer.ScrollBarThickness = 4
    colorContainer.ScrollBarImageColor3 = Color3.fromRGB(80, 60, 180)
    colorContainer.ClipsDescendants = true
    colorContainer.Parent = parent
    
    local colorCorner = Instance.new("UICorner")
    colorCorner.CornerRadius = UDim.new(0, 6)
    colorCorner.Parent = colorContainer
    
    local colorStroke = Instance.new("UIStroke")
    colorStroke.Color = Color3.fromRGB(80, 60, 180)
    colorStroke.Thickness = 1
    colorStroke.Transparency = 0.3
    colorStroke.Parent = colorContainer
    
    -- Собираем цвета в список
    local colorList = {}
    for key, preset in pairs(COLOR_PRESETS) do
        table.insert(colorList, {key = key, name = preset.name, colors = preset.colors})
    end
    
    -- Сортируем по имени
    table.sort(colorList, function(a, b) return a.name < b.name end)
    
    -- Создаем кнопки для каждого цвета
    local buttonHeight = 30
    for i, data in ipairs(colorList) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -4, 0, buttonHeight)
        btn.Position = UDim2.new(0, 2, 0, (i-1) * (buttonHeight + 4) + 2)
        btn.BackgroundColor3 = data.colors[1]
        btn.BackgroundTransparency = 0.2
        btn.Text = data.name
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 12
        btn.Font = Enum.Font.Jura
        btn.TextXAlignment = Enum.TextXAlignment.Center
        btn.Parent = colorContainer
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = btn
        
        -- Индикатор выбранного цвета
        local indicator = Instance.new("Frame")
        indicator.Size = UDim2.new(0, 8, 0, 8)
        indicator.Position = UDim2.new(1, -14, 0.5, -4)
        indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        indicator.BackgroundTransparency = 1
        indicator.Parent = btn
        
        local indCorner = Instance.new("UICorner")
        indCorner.CornerRadius = UDim.new(1, 0)
        indCorner.Parent = indicator
        
        btn.Activated:Connect(function()
            -- Применяем цвет
            ApplyColors(data.key)
            
            -- Обновляем индикаторы
            for _, child in ipairs(colorContainer:GetChildren()) do
                if child:IsA("TextButton") then
                    local ind = child:FindFirstChild("Indicator")
                    if ind then
                        ind.BackgroundTransparency = 1
                    end
                end
            end
            indicator.BackgroundTransparency = 0
            indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            
            -- Обновляем заголовок
            header.Text = "🎨 " .. data.name
        end)
        
        -- Если это текущий цвет, отмечаем
        if data.key == _G.Menu.CurrentColor then
            indicator.BackgroundTransparency = 0
            indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            header.Text = "🎨 " .. data.name
        end
    end
    
    -- Обновляем размер контейнера
    colorContainer.CanvasSize = UDim2.new(0, 0, 0, #colorList * (buttonHeight + 4) + 4)
    
    -- Обновляем размер родительского контейнера
    local count = 0
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
            count = count + 1
        end
    end
    FunctionContainer.CanvasSize = UDim2.new(0, 0, 0, count * 40 + 10)
end

