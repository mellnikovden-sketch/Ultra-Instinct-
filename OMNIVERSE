-- Категория
local CategoryButton = {}
CategoryButton.__index = CategoryButton

function CategoryButton.new(name, parent)
    local self = setmetatable({}, CategoryButton)
    self.Name = name
    self.Active = false
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -5, 0, 35)
    btn.Position = UDim2.new(0, 2, 0, #parent:GetChildren() * 38 + 5)
    btn.BackgroundTransparency = 1
    btn.Text = name
    btn.TextColor3 = COLORS.textDim
    btn.TextSize = 12
    btn.Font = Enum.Font.Jura
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = parent
    
    local hoverCorner = Instance.new("UICorner")
    hoverCorner.CornerRadius = UDim.new(0, 6)
    hoverCorner.Parent = btn
    
    self.Button = btn
    self.Container = Instance.new("Frame")
    self.Container.Size = UDim2.new(1, 0, 1, 0)
    self.Container.BackgroundTransparency = 1
    self.Container.Visible = false
    self.Container.Parent = FunctionContainer
    
    parent.CanvasSize = UDim2.new(0, 0, 0, #parent:GetChildren() * 38 + 10)
    
    -- ИСПРАВЛЕНО: Используем Activated
    btn.Activated:Connect(function()
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundTransparency = 1
                child.TextColor3 = COLORS.textDim
            end
        end
        self.Active = true
        btn.BackgroundTransparency = 0.9
        btn.BackgroundColor3 = COLORS.bgHover
        btn.TextColor3 = COLORS.accent
        
        for _, child in ipairs(FunctionContainer:GetChildren()) do
            if child:IsA("Frame") and child ~= self.Container then
                child.Visible = false
            end
        end
        self.Container.Visible = true
        
        -- Обновляем размер контента
        local count = 0
        for _, child in ipairs(self.Container:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
                count = count + 1
            end
        end
        FunctionContainer.CanvasSize = UDim2.new(0, 0, 0, count * 35 + 10)
    end)
    
    -- Если это первая категория, активируем её
    if #parent:GetChildren() == 1 then
        btn.Activated:Wait()
    end
    
    return self
end

