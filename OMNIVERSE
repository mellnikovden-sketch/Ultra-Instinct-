local function AddSlider(text, min, max, default, callback, parent)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -10, 0, 50)
    container.Position = UDim2.new(0, 5, 0, #parent:GetChildren() * 35 + 5)
    container.BackgroundTransparency = 1
    container.Parent = parent
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 20)
    label.Position = UDim2.new(0, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text .. ": " .. tostring(default)
    label.TextColor3 = COLORS.text
    label.TextSize = 12
    label.Font = Enum.Font.Jura
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container
    
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Size = UDim2.new(1, 0, 0, 20)
    sliderFrame.Position = UDim2.new(0, 0, 0, 22)
    sliderFrame.BackgroundColor3 = COLORS.bgSecondary
    sliderFrame.Parent = container
    
    local sliderCorner = Instance.new("UICorner")
    sliderCorner.CornerRadius = UDim.new(1, 0)
    sliderCorner.Parent = sliderFrame
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = COLORS.accent
    fill.Parent = sliderFrame
    
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = fill
    
    local value = default
    local dragging = false
    
    local function UpdateSlider(input)
        local pos = input.Position.X - sliderFrame.AbsolutePosition.X
        local width = sliderFrame.AbsoluteSize.X
        if width <= 0 then return end
        local percent = math.clamp(pos / width, 0, 1)
        value = min + (max - min) * percent
        value = math.floor(value)
        fill.Size = UDim2.new(percent, 0, 1, 0)
        label.Text = text .. ": " .. tostring(value)
        if callback then callback(value) end
    end
    
    sliderFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            UpdateSlider(input)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            UpdateSlider(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UpdateContainerSize(parent)
    return container
end

local function AddDropdown(text, options, callback, parent)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -10, 0, 40)
    container.Position = UDim2.new(0, 5, 0, #parent:GetChildren() * 35 + 5)
    container.BackgroundTransparency = 1
    container.Parent = parent
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.4, 0, 1, 0)
    label.Position = UDim2.new(0, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = COLORS.text
    label.TextSize = 12
    label.Font = Enum.Font.Jura
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container
    
    local dropdown = Instance.new("TextButton")
    dropdown.Size = UDim2.new(0.55, 0, 1, 0)
    dropdown.Position = UDim2.new(0.45, 0, 0, 0)
    dropdown.BackgroundColor3 = COLORS.bgSecondary
    dropdown.BackgroundTransparency = 0.5
    dropdown.Text = options[1] or "Select"
    dropdown.TextColor3 = COLORS.text
    dropdown.TextSize = 11
    dropdown.Font = Enum.Font.Jura
    dropdown.Parent = container
    
    local dropCorner = Instance.new("UICorner")
    dropCorner.CornerRadius = UDim.new(0, 6)
    dropCorner.Parent = dropdown
    
    local isOpen = false
    local dropList = nil
    
    -- ИСПРАВЛЕНО: Используем Activated
    dropdown.Activated:Connect(function()
        if isOpen then
            if dropList then dropList:Destroy() end
            isOpen = false
            return
        end
        
        dropList = Instance.new("Frame")
        dropList.Size = UDim2.new(0.55, 0, 0, #options * 25)
        dropList.Position = UDim2.new(0.45, 0, 1, 2)
        dropList.BackgroundColor3 = COLORS.bgSecondary
        dropList.BackgroundTransparency = 0.1
        dropList.ClipsDescendants = true
        dropList.Parent = container
        
        local listCorner = Instance.new("UICorner")
        listCorner.CornerRadius = UDim.new(0, 6)
        listCorner.Parent = dropList
        
        for i, option in ipairs(options) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 25)
            btn.Position = UDim2.new(0, 0, 0, (i-1) * 25)
            btn.BackgroundTransparency = 1
            btn.Text = option
            btn.TextColor3 = COLORS.text
            btn.TextSize = 11
            btn.Font = Enum.Font.Jura
            btn.Parent = dropList
            
            btn.MouseEnter:Connect(function()
                btn.BackgroundTransparency = 0.8
                btn.BackgroundColor3 = COLORS.bgHover
            end)
            
            btn.MouseLeave:Connect(function()
                btn.BackgroundTransparency = 1
            end)
            
            -- ИСПРАВЛЕНО: Используем Activated
            btn.Activated:Connect(function()
                dropdown.Text = option
                if callback then callback(option) end
                if dropList then dropList:Destroy() end
                isOpen = false
            end)
        end
        
        isOpen = true
    end)
    
    UpdateContainerSize(parent)
    return container
end

