function _G.Menu:AddCategory(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -5, 0, 40)
    btn.Position = UDim2.new(0, 2, 0, #CategoryContainer:GetChildren() * 43 + 5)
    btn.BackgroundTransparency = 1
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(150, 140, 170)
    btn.TextSize = 14
    btn.Font = Enum.Font.Jura
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = CategoryContainer
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    container.Visible = false
    container.Parent = FunctionContainer
    
    CategoryContainer.CanvasSize = UDim2.new(0, 0, 0, #CategoryContainer:GetChildren() * 43 + 10)
    
    btn.Activated:Connect(function()
        local colors = _G.Menu.CurrentColorPreset and _G.Menu.CurrentColorPreset.colors or COLOR_PRESETS.OVERDRIVE.colors
        for _, child in ipairs(CategoryContainer:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundTransparency = 1
                child.TextColor3 = Color3.fromRGB(150, 140, 170)
            end
        end
        btn.BackgroundTransparency = 0.9
        btn.BackgroundColor3 = Color3.fromRGB(40, 30, 60)
        btn.TextColor3 = colors[2] or Color3.fromRGB(180, 150, 255)
        
        for _, child in ipairs(FunctionContainer:GetChildren()) do
            if child:IsA("Frame") and child ~= container then
                child.Visible = false
            end
        end
        container.Visible = true
        
        local count = 0
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
                count = count + 1
            end
        end
        FunctionContainer.CanvasSize = UDim2.new(0, 0, 0, count * 40 + 10)
    end)
    
    if #CategoryContainer:GetChildren() == 1 then
        btn.Activated:Wait()
    end
    
    _G.Menu.Categories[name] = container
    return container
end

