    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
        if Dragging then
            local Delta = input.Position - DragStart
            local scaleX = StartPos.X.Scale
            local scaleY = StartPos.Y.Scale
            local offsetX = StartPos.X.Offset + Delta.X / ScreenGui.AbsoluteSize.X
            local offsetY = StartPos.Y.Offset + Delta.Y / ScreenGui.AbsoluteSize.Y
            
            MainFrame.Position = UDim2.new(scaleX, offsetX * ScreenGui.AbsoluteSize.X, scaleY, offsetY * ScreenGui.AbsoluteSize.Y)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = false
