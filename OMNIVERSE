local function CreateCategoryButton(name, parent)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -5, 0, 40)
    btn.Position = UDim2.new(0, 2, 0, #parent:GetChildren() * 43 + 5)
    btn.BackgroundTransparency = 1
    btn.Text = name
    btn.TextColor3 = COLORS.textDim
    btn.TextSize = 14
    btn.Font = Enum.Font.Jura
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = parent
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    container.Visible = false
    container.Parent = FunctionContainer
    
    parent.CanvasSize = UDim2.new(0, 0, 0, #parent:GetChildren() * 43 + 10)
    
    btn.Activated:Connect(function()
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundTransparency = 1
                child.TextColor3 = COLORS.textDim
            end
        end
        btn.BackgroundTransparency = 0.9
        btn.BackgroundColor3 = COLORS.bgHover
        btn.TextColor3 = COLORS.accentLight
        
        for _, child in ipairs(FunctionContainer:GetChildren()) do
            if child:IsA("Frame") and child ~= container then
                child.Visible = false
            end
        end
        container.Visible = true
        
        local count = 0
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
                count = count + 1
            end
        end
        FunctionContainer.CanvasSize = UDim2.new(0, 0, 0, count * 40 + 10)
    end)
    
    if #parent:GetChildren() == 1 then
        btn.Activated:Wait()
    end
    
    return container
end

local function UpdateContainerSize(parent)
    local count = 0
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
            count = count + 1
        end
    end
    if parent.Parent and parent.Parent:IsA("ScrollingFrame") then
        parent.Parent.CanvasSize = UDim2.new(0, 0, 0, count * 40 + 10)
    end
end

