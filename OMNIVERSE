function _G.Menu:AddToggle(text, callback, category)
    local parent = _G.Menu.Categories[category]
    if not parent then
        parent = _G.Menu:AddCategory(category)
    end
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -10, 0, 40)
    container.Position = UDim2.new(0, 5, 0, #parent:GetChildren() * 40 + 5)
    container.BackgroundTransparency = 1
    container.Parent = parent
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(200, 190, 220)
    label.TextSize = 14
    label.Font = Enum.Font.Jura
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container
    
    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0, 65, 0, 30)
    toggle.Position = UDim2.new(1, -70, 0.5, -15)
    toggle.BackgroundColor3 = Color3.fromRGB(20, 16, 35)
    toggle.Text = "OFF"
    toggle.TextColor3 = Color3.fromRGB(150, 140, 170)
    toggle.TextSize = 12
    toggle.Font = Enum.Font.Jura
    toggle.Parent = container
    
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(1, 0)
    toggleCorner.Parent = toggle
    
    local state = false
    
    toggle.Activated:Connect(function()
        state = not state
        if state then
            toggle.BackgroundColor3 = Color3.fromRGB(120, 80, 255)
            toggle.Text = "ON"
            toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            toggle.BackgroundColor3 = Color3.fromRGB(20, 16, 35)
            toggle.Text = "OFF"
            toggle.TextColor3 = Color3.fromRGB(150, 140, 170)
        end
        if callback then callback(state) end
    end)
    
    local count = 0
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
            count = count + 1
        end
    end
    FunctionContainer.CanvasSize = UDim2.new(0, 0, 0, count * 40 + 10)
    return container
end

