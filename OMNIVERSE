-- ПРИМЕНЕНИЕ ЦВЕТА
-- ═══════════════════════════════════════════════════════════

function ApplyColors(colorKey)
    local preset = COLOR_PRESETS[colorKey]
    if not preset then return end
    
    _G.Menu.CurrentColor = colorKey
    _G.Menu.CurrentColorPreset = preset
    local colors = preset.colors
    
    -- Обновляем обводку
    if Stroke then
        Stroke.Color = colors[1]
    end
    if StrokeGradient then
        local seq = {}
        for i, color in ipairs(colors) do
            table.insert(seq, ColorSequenceKeypoint.new((i-1)/(#colors-1), color))
        end
        StrokeGradient.Color = ColorSequence.new(seq)
    end
    
    -- Обновляем кнопку
    if OpenButton then
        OpenButton.ImageColor3 = colors[3] or colors[1]
        OpenLabel.TextColor3 = colors[3] or colors[1]
        if OpenStroke then
            OpenStroke.Color = colors[1]
        end
    end
    
    -- Обновляем заголовок
    if TitleLabel then
        TitleLabel.TextColor3 = colors[2] or colors[3]
    end
    
    -- Обновляем статус
    if StatusLabel then
        StatusLabel.TextColor3 = colors[3] or Color3.fromRGB(80, 255, 150)
    end
    
    -- Обновляем категории
    for _, child in ipairs(CategoryContainer:GetChildren()) do
        if child:IsA("TextButton") and child.BackgroundTransparency < 1 then
            child.TextColor3 = colors[2] or Color3.fromRGB(180, 150, 255)
        end
    end
    
    print("[COLOR] Applied: " .. preset.name)
end

