function _G.Menu:AddCategory(name)
    local cat = CategoryButton.new(name, CategoryContainer)
    self.Categories[name] = cat
    return cat.Container
end

function _G.Menu:AddLabel(text, category)
    local parent = self.Categories[category]
    if not parent then
        parent = self:AddCategory(category)
    end
    return AddLabel(text, parent)
end

function _G.Menu:AddSeparator(category)
    local parent = self.Categories[category]
    if not parent then
        parent = self:AddCategory(category)
    end
    return AddSeparator(parent)
end

function _G.Menu:AddToggle(text, callback, category)
    local parent = self.Categories[category]
    if not parent then
        parent = self:AddCategory(category)
    end
    return AddToggle(text, callback, parent)
end

function _G.Menu:AddButton(text, callback, category)
    local parent = self.Categories[category]
    if not parent then
        parent = self:AddCategory(category)
    end
    return AddButton(text, callback, parent)
end

function _G.Menu:AddSlider(text, min, max, default, callback, category)
    local parent = self.Categories[category]
    if not parent then
        parent = self:AddCategory(category)
    end
    return AddSlider(text, min, max, default, callback, parent)
end

function _G.Menu:AddDropdown(text, options, callback, category)
    local parent = self.Categories[category]
    if not parent then
        parent = self:AddCategory(category)
    end
    return AddDropdown(text, options, callback, parent)
end

