local function ToggleMenu()
    _G.Menu.IsOpen = not _G.Menu.IsOpen
    MainFrame.Visible = _G.Menu.IsOpen
    OpenButton.Visible = not _G.Menu.IsOpen
end

-- ИСПРАВЛЕНО: Используем Activated
OpenButton.Activated:Connect(function()
    ToggleMenu()
end)

-- Закрытие по нажатию вне меню
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Touch then
        if MainFrame.Visible then
            local pos = input.Position
            local absPos = MainFrame.AbsolutePosition
            local size = MainFrame.AbsoluteSize
            
            if not (pos.X >= absPos.X and pos.X <= absPos.X + size.X and
                    pos.Y >= absPos.Y and pos.Y <= absPos.Y + size.Y) then
                local btnPos = OpenButton.AbsolutePosition
                local btnSize = OpenButton.AbsoluteSize
                if not (pos.X >= btnPos.X and pos.X <= btnPos.X + btnSize.X and
                        pos.Y >= btnPos.Y and pos.Y <= btnPos.Y + btnSize.Y) then
                    ToggleMenu()
                end
            end
        end
    end
end)

