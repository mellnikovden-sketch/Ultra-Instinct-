    local function MakeDraggable(frame)
        local dragging = false
        local dragStart = nil
        local startPos = nil
        
        frame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or 
               input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = frame.Position
            end
        end)
        
        frame.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or 
               input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        
        __UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or 
                             input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                local parentSize = frame.Parent.AbsoluteSize
                if parentSize.X > 0 and parentSize.Y > 0 then
                    frame.Position = __UD2(
                        startPos.X.Scale + (delta.X / parentSize.X),
                        0,
                        startPos.Y.Scale + (delta.Y / parentSize.Y),
                        0
                    )
                end
            end
        end)
