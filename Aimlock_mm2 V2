        if gameProcessed then return end
        
        local key = input.KeyCode
        
        if key == Enum.KeyCode.T then ToggleAimLock() end
        if key == Enum.KeyCode.G then ToggleWallCheck() end
        if key == Enum.KeyCode.E then ToggleOutline() end
        if key == Enum.KeyCode.W then ToggleWallhop() end
        if key == Enum.KeyCode.B then ToggleBombJump() end
        if key == Enum.KeyCode.Z then ToggleGoldBomb() end
        if key == Enum.KeyCode.R then ToggleResetGUI() end
    end)
    
    RootMaid:GiveTask(inputBeganConnection)
end

