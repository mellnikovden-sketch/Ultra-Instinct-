-- RT SYSTEM (RESET) - ОТДЕЛЬНОЕ GUI ПО ЦЕНТРУ
-- ==============================================
local ResetState = {
    noclipEnabled = false,
    antiFlingEnabled = true,
    resetSelPlr = nil,
    whitelist = {},
    activeResets = {},
    maxRetries = 3,
    retryDelay = 0.15,
    resetGuiOpen = false,
    roleCache = {
        data = nil,
        timestamp = 0,
        TTL = 0.8,
    },
    antiFlingMaid = nil,
    antiFlingConn = nil,
    antiFlingBV = nil,
    antiFlingBG = nil,
}

local function Reset_Notify(title, msg)
    if msg then
        print("🔔 " .. title .. ": " .. msg)
    else
        print("🔔 " .. title)
    end
end

local function Reset_restoreCollision()
    if ResetState.noclipEnabled then return end
    local character = LocalPlayer.Character
    if character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end

local function Reset_setNoclip(state)
    ResetState.noclipEnabled = state
    if not state then Reset_restoreCollision() end
end

local function Reset_getCachedRoleData()
    local now = tick()
    if ResetState.roleCache.data and (now - ResetState.roleCache.timestamp) < ResetState.roleCache.TTL then
        return ResetState.roleCache.data
    end
    local ok, result = pcall(function()
        local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if remote and remote:IsA("RemoteFunction") then
            return remote:InvokeServer()
        end
    end)
    if ok and result then
        ResetState.roleCache.data = result
        ResetState.roleCache.timestamp = now
        return result
    end
    ResetState.roleCache.timestamp = now
    return ResetState.roleCache.data
end

local function Reset_getMyRole()
    local roleData = Reset_getCachedRoleData()
    if not roleData then return nil end
    local data = roleData[LocalPlayer.Name]
    if data then return data.Role end
    return nil
end

local function Reset_iAmMurderer() return Reset_getMyRole() == "Murderer" end
local function Reset_iAmSheriff() return Reset_getMyRole() == "Sheriff" end

local function Reset_canTargetSheriff() return not Reset_iAmMurderer() end
local function Reset_canTargetMurderer() return not Reset_iAmMurderer() end

local function Reset_isWhitelisted(player)
    return ResetState.whitelist[player.UserId] == true
end

local function Reset_restoreSelf(character, savedData, originalDestroyHeight)
    if not character or not savedData then
        Workspace.FallenPartsDestroyHeight = originalDestroyHeight
        return
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then
        Workspace.FallenPartsDestroyHeight = originalDestroyHeight
        return
    end
    Workspace.FallenPartsDestroyHeight = originalDestroyHeight
    rootPart.CFrame = savedData.cframe
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    rootPart.Velocity = Vector3.zero
    rootPart.RotVelocity = Vector3.zero
    humanoid.PlatformStand = false
    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    if humanoid.Health < humanoid.MaxHealth then
        humanoid.Health = humanoid.MaxHealth
    end
    if not ResetState.noclipEnabled then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end

local function Reset_lockSelf(rootPart, lockCFrame)
    if ResetState.antiFlingBV then pcall(function() ResetState.antiFlingBV:Destroy() end) end
    if ResetState.antiFlingBG then pcall(function() ResetState.antiFlingBG:Destroy() end) end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = rootPart
    ResetState.antiFlingBV = bv

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 9e8
    bg.CFrame = lockCFrame
    bg.Parent = rootPart
    ResetState.antiFlingBG = bg
end

local function Reset_unlockSelf()
    if ResetState.antiFlingBV then pcall(function() ResetState.antiFlingBV:Destroy() end) ResetState.antiFlingBV = nil end
    if ResetState.antiFlingBG then pcall(function() ResetState.antiFlingBG:Destroy() end) ResetState.antiFlingBG = nil end
end

local function Reset_startAntiFlingLoop()
    if ResetState.antiFlingConn then ResetState.antiFlingConn:Disconnect() ResetState.antiFlingConn = nil end
    if not ResetState.antiFlingMaid then ResetState.antiFlingMaid = Maid.new() end

    ResetState.antiFlingConn = RunService.Heartbeat:Connect(function()
        if not ResetState.antiFlingEnabled then return end
        if next(ResetState.activeResets) ~= nil then return end

        local character = LocalPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not rootPart then return end

        local vel = rootPart.AssemblyLinearVelocity
        local isFlung = math.abs(vel.X) > 500 or math.abs(vel.Y) > 500 or math.abs(vel.Z) > 500

        if isFlung then
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.Velocity = Vector3.zero
            rootPart.RotVelocity = Vector3.zero
            humanoid.PlatformStand = false
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            if humanoid.Health < humanoid.MaxHealth then
                pcall(function() humanoid.Health = humanoid.MaxHealth end)
            end
        end
    end)

    ResetState.antiFlingMaid:GiveTask(function()
        if ResetState.antiFlingConn then ResetState.antiFlingConn:Disconnect() ResetState.antiFlingConn = nil end
        Reset_unlockSelf()
    end)
end

Reset_startAntiFlingLoop()
RootMaid:GiveTask(function()
    if ResetState.antiFlingMaid then ResetState.antiFlingMaid:Destroy() ResetState.antiFlingMaid = nil end
end)

local MAX_CONCURRENT_RESETS = 6

local function Reset_countActiveResets()
    local count = 0
    for _ in pairs(ResetState.activeResets) do count = count + 1 end
    return count
end

local function VoidReset(TargetPlayer, _retryCount)
    if TargetPlayer == LocalPlayer then return end
    if Reset_isWhitelisted(TargetPlayer) then return end
    if ResetState.activeResets[TargetPlayer.UserId] then return end

    _retryCount = _retryCount or 0

    if Reset_countActiveResets() >= MAX_CONCURRENT_RESETS then
        task.defer(function()
            task.wait(0.05 * (_retryCount + 1))
            VoidReset(TargetPlayer, _retryCount)
        end)
        return
    end

    local Character = LocalPlayer.Character
    if not Character then return end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    local TCharacter = TargetPlayer.Character
    if not (Humanoid and RootPart and TCharacter) then return end

    local TRootPart = TCharacter:FindFirstChild("HumanoidRootPart")
    if not TRootPart then return end

    local touchParts = {}
    for _, name in ipairs({"HumanoidRootPart", "Head", "UpperTorso", "Torso", "LowerTorso", "LeftUpperArm", "RightUpperArm"}) do
        local p = TCharacter:FindFirstChild(name)
        if p then table.insert(touchParts, p) end
    end
    if #touchParts == 0 then
        for _, part in ipairs(TCharacter:GetChildren()) do
            if part:IsA("BasePart") then table.insert(touchParts, part) end
        end
    end

    local savedCF = RootPart.CFrame
    local originalDestroyHeight = Workspace.FallenPartsDestroyHeight
    local done = false
    local touchLanded = false

    Workspace.FallenPartsDestroyHeight = -math.huge
    Humanoid.PlatformStand = true

    Reset_lockSelf(RootPart, savedCF)

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(0, -200000, 0)
    bv.Parent = RootPart

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 9e8
    bg.Parent = RootPart

    local startTime = tick()
    local RESET_DURATION = 0.6
    local resetObj = { bv = bv, bg = bg, conn = nil }
    ResetState.activeResets[TargetPlayer.UserId] = resetObj

    local function cleanup(killedOrGone)
        if done then return end
        done = true
        ResetState.activeResets[TargetPlayer.UserId] = nil
        if resetObj.conn then
            resetObj.conn:Disconnect()
            resetObj.conn = nil
        end
        pcall(function() bv:Destroy() end)
        pcall(function() bg:Destroy() end)

        Reset_unlockSelf()
        Reset_restoreSelf(Character, { cframe = savedCF }, originalDestroyHeight)

        local graceDelay = (touchLanded and not killedOrGone) and 1.5 or 0
        task.delay(graceDelay, function()
            Workspace.FallenPartsDestroyHeight = originalDestroyHeight
        end)

        if not killedOrGone and not touchLanded and _retryCount < ResetState.maxRetries then
            task.delay(ResetState.retryDelay, function()
                if TargetPlayer.Parent and not Reset_isWhitelisted(TargetPlayer) then
                    VoidReset(TargetPlayer, _retryCount + 1)
                end
            end)
        end
    end

    resetObj.conn = RunService.Heartbeat:Connect(function()
        if not TargetPlayer.Character or not TRootPart.Parent then
            cleanup(true)
            return
        end

        if tick() - startTime >= RESET_DURATION then
            cleanup(false)
            return
        end

        if not Character.Parent or not RootPart.Parent then
            cleanup(true)
            return
        end

        local tVel = TRootPart.AssemblyLinearVelocity
        local leadT = math.clamp(tVel.Magnitude / 600, 0, 0.06) + 0.03
        local aimPos = TRootPart.Position + tVel * leadT

        RootPart.CFrame = CFrame.new(aimPos)
        RootPart.AssemblyLinearVelocity = Vector3.new(0, -200000, 0)
        RootPart.AssemblyAngularVelocity = Vector3.new(15000, 15000, 15000)

        local elapsed = tick() - startTime
        local touchReps = elapsed < 0.2 and 8 or 5
        for _ = 1, touchReps do
            for _, part in ipairs(touchParts) do
                local ok1 = pcall(firetouchinterest, RootPart, part, 0)
                local ok2 = pcall(firetouchinterest, RootPart, part, 1)
                if ok1 and ok2 then touchLanded = true end
            end
        end

        pcall(sethiddenproperty, RootPart, "PhysicsRepRootPart", TRootPart)

        if Humanoid.Health < Humanoid.MaxHealth then
            pcall(function() Humanoid.Health = Humanoid.MaxHealth end)
        end
    end)
end

local function Reset_findSheriff()
    if not Reset_canTargetSheriff() then return nil end
    local roleData = Reset_getCachedRoleData()
    if roleData then
        for playerName, data in pairs(roleData) do
            if data.Role == "Sheriff" and not data.Killed and not data.Dead then
                local p = Players:FindFirstChild(playerName)
                if p and p ~= LocalPlayer and not Reset_isWhitelisted(p) then return p end
            end
        end
    end
    return nil
end

local function Reset_findMurderer()
    if not Reset_canTargetMurderer() then return nil end
    local roleData = Reset_getCachedRoleData()
    if roleData then
        for playerName, data in pairs(roleData) do
            if data.Role == "Murderer" and not data.Killed and not data.Dead then
                local p = Players:FindFirstChild(playerName)
                if p and p ~= LocalPlayer and not Reset_isWhitelisted(p) then return p end
            end
        end
    end
    return nil
end

