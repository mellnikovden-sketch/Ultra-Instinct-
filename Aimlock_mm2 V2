        sectionLabel.TextColor3 = COLORS.accent
        sectionLabel.TextSize = 10
        sectionLabel.TextXAlignment = Enum.TextXAlignment.Center
        sectionLabel.Parent = section
        
        local playersContainer = Instance.new("Frame")
        playersContainer.Size = __UD2(1, 0, 0, 48)
        playersContainer.Position = __UD2(0, 0, 0, 20)
        playersContainer.BackgroundTransparency = 1
        playersContainer.ClipsDescendants = true
        playersContainer.Parent = section
        
        local playersScroll = Instance.new("ScrollingFrame")
        playersScroll.Size = __UD2(1, 0, 1, 0)
        playersScroll.Position = __UD2(0, 0, 0, 0)
        playersScroll.BackgroundTransparency = 1
        playersScroll.BorderSizePixel = 0
        playersScroll.CanvasSize = __UD2(0, 0, 0, 0)
        playersScroll.ScrollBarThickness = 3
        playersScroll.ScrollBarImageColor3 = COLORS.border
