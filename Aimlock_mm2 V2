        local playersLayout = Instance.new("UIListLayout")
        playersLayout.FillDirection = Enum.FillDirection.Horizontal
        playersLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        playersLayout.SortOrder = Enum.SortOrder.LayoutOrder
        playersLayout.Padding = UDim.new(0, 4)
        playersLayout.Parent = playersScroll
        
        local function UpdatePlayersList()
            for _, child in ipairs(playersScroll:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            
            local playerCount = 0
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local btn = Instance.new("TextButton")
                    btn.Size = __UD2(0, 58, 0, 40)
                    btn.BackgroundColor3 = __RGB(40, 28, 60)
                    btn.BackgroundTransparency = 0.3
                    btn.BorderSizePixel = 0
                    btn.Font = Enum.Font.Jura
                    btn.Text = player.Name
                    btn.TextColor3 = COLORS.text
                    btn.TextSize = 9
                    btn.TextWrapped = true
                    btn.Parent = playersScroll
                    
                    Instance.new("UICorner", btn).CornerRadius = __UD(0, 4)
                    
                    if ResetState.resetSelPlr and ResetState.resetSelPlr.UserId == player.UserId then
                        btn.BackgroundColor3 = __RGB(80, 50, 120)
                        btn.TextColor3 = __RGB(255, 255, 255)
                    end
                    
                    btn.MouseEnter:Connect(function()
                        if ResetState.resetSelPlr and ResetState.resetSelPlr.UserId ~= player.UserId then
                            btn.BackgroundTransparency = 0.1
                        end
                    end)
                    
                    btn.MouseLeave:Connect(function()
                        if ResetState.resetSelPlr and ResetState.resetSelPlr.UserId ~= player.UserId then
                            btn.BackgroundTransparency = 0.3
                        end
                    end)
                    
                    btn.MouseButton1Click:Connect(function()
                        for _, child in ipairs(playersScroll:GetChildren()) do
                            if child:IsA("TextButton") then
                                child.BackgroundColor3 = __RGB(40, 28, 60)
                                child.TextColor3 = COLORS.text
                                child.BackgroundTransparency = 0.3
                            end
                        end
                        btn.BackgroundColor3 = __RGB(80, 50, 120)
                        btn.TextColor3 = __RGB(255, 255, 255)
                        btn.BackgroundTransparency = 0.1
                        
                        ResetState.resetSelPlr = player
                        Reset_Notify("Selected", player.Name)
                    end)
                    
                    playerCount = playerCount + 1
                end
            end
            
            local totalWidth = playerCount * 62
            playersScroll.CanvasSize = __UD2(0, math.max(totalWidth, 240), 0, 0)
        end
        
        UpdatePlayersList()
        
        local playerAddedConn = Players.PlayerAdded:Connect(UpdatePlayersList)
        local playerRemovingConn = Players.PlayerRemoving:Connect(UpdatePlayersList)
        
        RootMaid:GiveTask(playerAddedConn)
        RootMaid:GiveTask(playerRemovingConn)
        
        return section
    end
    
