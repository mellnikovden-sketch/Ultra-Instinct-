-- Raycast параметры для WallHop
local wallRaycastParams = RaycastParams.new()
wallRaycastParams.FilterType = Enum.RaycastFilterType.Blacklist

-- --- Функция проверки, является ли объект игроком ---
local function isPlayerCharacter(instance)
    if not instance then return false end
    local current = instance
    while current do
        if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
            local players = Players:GetPlayers()
            for _, player in ipairs(players) do
                if player.Character == current then
                    return true
                end
            end
        end
        current = current.Parent
    end
    return false
end

-- --- Функция проверки, является ли объект стеной ---
local function isWall(instance)
    if not instance or not instance.IsA then return false end
    
    -- Игнорируем игроков
    if instance:IsA("Part") and instance.Parent and instance.Parent:IsA("Model") and instance.Parent:FindFirstChild("Humanoid") then
        return false
    end
    
    -- Проверяем все родительские объекты на принадлежность игроку
    local current = instance
    while current do
        if isPlayerCharacter(current) then
            return false
        end
        current = current.Parent
    end
    
    -- Проверяем, что это часть с коллизией
    if not instance:IsA("BasePart") and not instance:IsA("Terrain") then
        return false
    end
    
    -- Проверяем CanCollide
    if instance:IsA("BasePart") and not instance.CanCollide then
        return false
    end
    
    return true
end

-- --- Функция получения результата Raycast для стены ---
local function getWallRaycastResult()
    local character = LocalPlayer.Character
    if not character then return nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    -- Добавляем в черный список персонажи других игроков
    local players = Players:GetPlayers()
    local blacklist = {character}
    for _, player in ipairs(players) do
        if player ~= LocalPlayer and player.Character then
            table.insert(blacklist, player.Character)
        end
    end
    wallRaycastParams.FilterDescendantsInstances = blacklist
    
    local closestHit, minDistance = nil, WallHop.detectionDistance
    local hrpCF = hrp.CFrame
    for i = 0,7 do
        local angle = math.rad(i*45)
        local dir = (hrpCF * CFrame.Angles(0, angle, 0)).LookVector
        local ray = workspace:Raycast(hrp.Position, dir * WallHop.detectionDistance, wallRaycastParams)
        if ray and ray.Instance and ray.Distance < minDistance then
            local hitInstance = ray.Instance
            if isWall(hitInstance) then
                minDistance = ray.Distance
                closestHit = ray
            end
        end
    end
    return closestHit
end

-- --- Флинг (Видео флинг) ---
local function performVideoFlick()
    if not WallHop.enabled then return end
    if WallHop.isFlicking then return end
    WallHop.isFlicking = true
    
    local char = LocalPlayer.Character
    if not char then WallHop.isFlicking = false return end
    
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then WallHop.isFlicking = false return end
    
    -- Проверяем, жив ли игрок
    if hum.Health <= 0 then WallHop.isFlicking = false return end
    
    -- Сохраняем текущее состояние
    local currentVel = hrp.Velocity
    
    -- Выполняем флинг
    hum:ChangeState(Enum.HumanoidStateType.Jumping)
    hrp.Velocity = Vector3.new(currentVel.X, WallHop.flickPower, currentVel.Z)
    
    -- Разворот камеры
    local Camera = workspace.CurrentCamera
    local startCFrame = Camera.CFrame
    Camera.CFrame = startCFrame * CFrame.Angles(0, math.rad(180), 0)
    
    task.wait(0.01)
    Camera.CFrame = startCFrame
    
    WallHop.isFlicking = false
end

-- --- Wallhop (Новая версия) ---
local function performWallhop()
    if not WallHop.enabled then return end
    
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not (humanoid and rootPart and humanoid:GetState() ~= Enum.HumanoidStateType.Dead) then return end
    
    local wall = getWallRaycastResult()
    if not wall then return end

    -- Поворачиваем игрока к стене
    rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + wall.Normal)
    RunService.Heartbeat:Wait()
    
    if humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        task.wait(0.1)
    end
end

-- --- Обнаружение стыков стен (Видео флинг) ---
local function wallHopHeartbeat()
    if not WallHop.enabled or WallHop.isFlicking then return end
    
    local char = LocalPlayer.Character
    if not char then 
        WallHop.lastHitInstance = nil
        return 
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then 
        WallHop.lastHitInstance = nil
        return 
    end
    
    -- Проверяем, зажат ли пробел
    if not WallHop.isJumpKeyPressed then 
        WallHop.lastHitInstance = nil
        return 
    end
    
    -- Создаем Raycast с улучшенной фильтрацией
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    
    -- Пускаем луч в направлении камеры
    local Camera = workspace.CurrentCamera
    local direction = Camera.CFrame.LookVector * WallHop.detectionDistance
    local result = workspace:Raycast(hrp.Position, direction, raycastParams)
    
    WallHop.currentHitInstance = nil
    
    if result then
        local hitInstance = result.Instance
        
        -- Проверяем, является ли объект стеной
        if isWall(hitInstance) then
            WallHop.currentHitInstance = hitInstance
            
            -- Проверяем смену стены (стык)
            if WallHop.lastHitInstance and WallHop.lastHitInstance ~= WallHop.currentHitInstance then
                local currentTime = os.clock()
                if currentTime - WallHop.lastFlickTime > 0.1 then
                    WallHop.lastFlickTime = currentTime
                    performVideoFlick()
                end
            end
        end
    end
    
    WallHop.lastHitInstance = WallHop.currentHitInstance
end

-- --- Функции управления WallHop ---
function ToggleWallHop()
    WallHop.enabled = not WallHop.enabled
    if WallHop.bindButton then
        BindableButtons.UpdateBButtonText("wallhop_toggle", WallHop.enabled and "WH:ON" or "WH:OFF", false, false)
        BindableButtons.UpdateBButtonColor("wallhop_toggle", WallHop.enabled, "wallhop")
    end
    print("🧱 WallHop: " .. (WallHop.enabled and "ENABLED" or "DISABLED"))
end

function SetWallHopDetection(dist)
    WallHop.detectionDistance = dist
end

function SetWallHopPower(power)
    WallHop.flickPower = power
end

-- --- Настройка WallHop ---
local function SetupWallHop()
    -- Подключение к Heartbeat
    RunService.Heartbeat:Connect(wallHopHeartbeat)
    
    -- Автоматический Wallhop при прыжке
    UserInputService.JumpRequest:Connect(function()
        if WallHop.enabled then
            performWallhop()
        end
    end)
    
    -- Отслеживание нажатия на прыжок
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.Space then
            WallHop.isJumpKeyPressed = true
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.Space then
            WallHop.isJumpKeyPressed = false
            WallHop.lastHitInstance = nil
        end
    end)
    
    -- Сброс состояния при респавне
    LocalPlayer.CharacterAdded:Connect(function()
        WallHop.lastHitInstance = nil
        WallHop.currentHitInstance = nil
        WallHop.isFlicking = false
    end)
    
    -- Сброс при потере фокуса
    UserInputService.WindowFocused:Connect(function()
        WallHop.isJumpKeyPressed = false
        WallHop.lastHitInstance = nil
    end)
end

