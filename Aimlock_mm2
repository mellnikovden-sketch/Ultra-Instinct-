    if not character then return false end
    
    local sheriffWeapons = {
        "gun", "pistol", "revolver", "shooter", "blaster", "glock"
    }
    
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            
            for _, wName in ipairs(sheriffWeapons) do
                if name:find(wName) or wName:find(name) then
                    return true
                end
            end
            
            if item:FindFirstChild("GunServer") or item:FindFirstChild("GunClient") then
                return true
            end
            
            if item.ToolTip and string.lower(item.ToolTip):find("gun") then
                return true
            end
        end
    end
    return false
end

local function GetPlayerRole(plr)
    if not plr or plr == LocalPlayer then return nil end
    if not plr.Character then return "Unknown" end
    
    local humanoid = plr.Character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return "Dead" end
    
    -- Проверяем атрибуты
    local murdererAttr = plr:GetAttribute("Murderer")
    local sheriffAttr = plr:GetAttribute("Sheriff")
    local roleAttr = plr:GetAttribute("Role")
    
    if murdererAttr == true or murdererAttr == "True" then
        return "Murderer"
    end
    if sheriffAttr == true or sheriffAttr == "True" then
        return "Sheriff"
    end
    if roleAttr == "Murderer" or roleAttr == "Murder" or roleAttr == "Killer" then
        return "Murderer"
    end
    if roleAttr == "Sheriff" or roleAttr == "Cop" then
        return "Sheriff"
    end
    
    -- Проверяем оружие в руках
    if FindMurdererWeapon(plr.Character) then
        return "Murderer"
    end
    
    if FindSheriffWeapon(plr.Character) then
        return "Sheriff"
    end
    
    -- Проверяем рюкзак
    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        if FindMurdererWeapon(backpack) then
            return "Murderer"
        end
        if FindSheriffWeapon(backpack) then
            return "Sheriff"
        end
    end
    
    return "Innocent"
end

-- ==============================================
-- ФУНКЦИЯ ПРОВЕРКИ ВИДИМОСТИ (WALLCHECK)
-- ==============================================
function IsPlayerVisible(plr)
    if not plr or not plr.Character then return false end
    
    local targetPart = plr.Character:FindFirstChild(TargetPart)
    if not targetPart then return false end
    
    local CurrentCamera = workspace.CurrentCamera
    if not CurrentCamera then return false end
    
    local raycastParams = RaycastParams.new()
    local filterList = {}
    
    if LocalPlayer.Character then 
        table.insert(filterList, LocalPlayer.Character) 
    end
    
    raycastParams.FilterDescendantsInstances = filterList
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local origin = CurrentCamera.CFrame.Position
    local direction = targetPart.Position - origin
    local result = workspace:Raycast(origin, direction, raycastParams)
    
    if not result then return true end
    return result.Instance:IsDescendantOf(plr.Character)
end

-- ==============================================
-- ПОИСК УБИЙЦЫ С УЧЁТОМ WALLCHECK
-- ==============================================
function FindMurderer(preferTarget)
    if preferTarget and preferTarget.Character then
        local hum = preferTarget.Character:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then
            if GetPlayerRole(preferTarget) == "Murderer" then
                if not WallCheckEnabled or IsPlayerVisible(preferTarget) then
                    return preferTarget
                end
            end
        end
    end

    local bestTarget = nil
    local bestDist = math.huge
    
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character then
            local role = GetPlayerRole(pl)
            if role == "Murderer" then
                local hum = pl.Character:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    if WallCheckEnabled and not IsPlayerVisible(pl) then
                        continue
                    end
                    
                    local root = pl.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if myRoot then
                            local dist = (root.Position - myRoot.Position).Magnitude
                            if dist < bestDist then
                                bestDist = dist
                                bestTarget = pl
                            end
                        end
                    end
                end
            end
        end
    end
    
    return bestTarget
end

-- ==============================================
-- OUTLINE СИСТЕМА С БЫСТРЫМ ОБНОВЛЕНИЕМ
-- ==============================================
local OutlinedPlayers = {}
local OutlineMaid = Maid.new()
local OutlineUpdateRate = 0.05
local LastOutlineUpdate = 0

local PlayerConnections = {}

local function GetOutlineColor(role, isDead)
    if isDead then
        return Color3.fromRGB(128, 128, 128)
    end
    
    if role == "Murderer" then
        return Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then
        return Color3.fromRGB(0, 150, 255)
    elseif role == "Innocent" then
        return Color3.fromRGB(0, 255, 0)
    else
        return Color3.fromRGB(255, 255, 255)
    end
end

local function GetRoleEmoji(role)
    if role == "Murderer" then
        return "🔪"
    elseif role == "Sheriff" then
        return "🔫"
    elseif role == "Innocent" then
        return "👤"
    else
        return "❓"
    end
end

local function IsPlayerInGame(plr)
    if not plr or not plr.Character then return false end
    
    local humanoid = plr.Character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    if humanoid.Health <= 0 then return false end
    
    return true
end

local function ApplyOutline(plr)
    if not plr or plr == LocalPlayer then return end
    if OutlinedPlayers[plr] then return end
    if not plr.Character then return end
    
    local role = GetPlayerRole(plr)
    local isDead = (role == "Dead" or role == "Unknown" or role == nil)
    local inGame = IsPlayerInGame(plr)
    
    if isDead or not inGame then
        return
    end
    
    local color = GetOutlineColor(role, false)
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "Outline_Highlight"
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0.2
    highlight.OutlineColor = color
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = plr.Character
    highlight.Parent = plr.Character
    
    local head = plr.Character:FindFirstChild("Head")
    local billboard = nil
    local nameLabel = nil
    
    if head then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "Outline_NameTag"
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.Adornee = head
        billboard.Parent = plr.Character
        billboard.AlwaysOnTop = true
        
        nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = GetRoleEmoji(role) .. " " .. plr.Name .. " [" .. role .. "]"
        nameLabel.TextColor3 = color
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.Jura
        nameLabel.TextStrokeTransparency = 0.2
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLabel.Parent = billboard
    end
    
    OutlinedPlayers[plr] = {
        Highlight = highlight,
        Billboard = billboard,
        Label = nameLabel,
        Role = role
    }
end

local function RemoveOutline(plr)
    if OutlinedPlayers[plr] then
        local data = OutlinedPlayers[plr]
        if data.Highlight then 
            pcall(function() data.Highlight:Destroy() end)
        end
        if data.Billboard then 
            pcall(function() data.Billboard:Destroy() end)
        end
        OutlinedPlayers[plr] = nil
    end
end

local function FullRefreshOutline()
    for plr, _ in pairs(OutlinedPlayers) do
        RemoveOutline(plr)
    end
    
    if OutlineEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local role = GetPlayerRole(plr)
                if role and role ~= "Dead" and role ~= "Unknown" then
                    if IsPlayerInGame(plr) then
                        ApplyOutline(plr)
                    end
                end
            end
        end
    end
end

local function UpdateOutline()
    if OutlineEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local role = GetPlayerRole(plr)
                local isDead = (role == "Dead" or role == "Unknown" or role == nil)
                local inGame = IsPlayerInGame(plr)
                
                if isDead or not inGame then
                    if OutlinedPlayers[plr] then
                        RemoveOutline(plr)
                    end
                else
                    if OutlinedPlayers[plr] then
                        local data = OutlinedPlayers[plr]
                        if data.Role ~= role then
                            local color = GetOutlineColor(role, false)
                            if data.Highlight then
                                data.Highlight.OutlineColor = color
                            end
                            if data.Label then
                                data.Label.Text = GetRoleEmoji(role) .. " " .. plr.Name .. " [" .. role .. "]"
                                data.Label.TextColor3 = color
                            end
                            data.Role = role
                        end
                    else
                        ApplyOutline(plr)
                    end
                end
            end
        end
    else
        for plr, _ in pairs(OutlinedPlayers) do
            RemoveOutline(plr)
        end
    end
end

local function OutlineUpdateLoop()
    if not OutlineEnabled then return end
    
    local now = os.clock()
    if now - LastOutlineUpdate < OutlineUpdateRate then return end
    LastOutlineUpdate = now
    
    UpdateOutline()
end

local function SetupPlayer(plr)
    if plr == LocalPlayer then return end
    
    if PlayerConnections[plr] then
        PlayerConnections[plr]:Disconnect()
        PlayerConnections[plr] = nil
    end
    
    if OutlineEnabled then
        task.wait(0.05)
        
        if plr.Character then
            local role = GetPlayerRole(plr)
            if role and role ~= "Dead" and role ~= "Unknown" then
                if IsPlayerInGame(plr) then
                    ApplyOutline(plr)
                end
            end
        end
        
        local conn = plr.CharacterAdded:Connect(function()
            task.wait(0.05)
            
            if OutlineEnabled then
                RemoveOutline(plr)
                local role = GetPlayerRole(plr)
                if role and role ~= "Dead" and role ~= "Unknown" then
                    if IsPlayerInGame(plr) then
                        ApplyOutline(plr)
                    end
                end
            end
        end)
        
        PlayerConnections[plr] = conn
        OutlineMaid:GiveTask(conn)
    else
        local conn = plr.CharacterAdded:Connect(function()
            if OutlineEnabled then
                task.wait(0.05)
                RemoveOutline(plr)
                local role = GetPlayerRole(plr)
                if role and role ~= "Dead" and role ~= "Unknown" then
                    if IsPlayerInGame(plr) then
                        ApplyOutline(plr)
                    end
                end
            end
        end)
        
        PlayerConnections[plr] = conn
        OutlineMaid:GiveTask(conn)
    end
end

for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        SetupPlayer(plr)
    end
end

Players.PlayerAdded:Connect(function(plr)
    SetupPlayer(plr)
    
    task.wait(0.1)
    if OutlineEnabled and plr.Character and not OutlinedPlayers[plr] then
        local role = GetPlayerRole(plr)
        if role and role ~= "Dead" and role ~= "Unknown" and IsPlayerInGame(plr) then
            ApplyOutline(plr)
        end
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    RemoveOutline(plr)
    if PlayerConnections[plr] then
        PlayerConnections[plr]:Disconnect()
        PlayerConnections[plr] = nil
    end
end)

local function OnRoundChange()
    task.wait(0.2)
    
    if OutlineEnabled then
        FullRefreshOutline()
    end
end

local LastPlayerCount = #Players:GetPlayers()
Players.PlayerAdded:Connect(function()
    task.wait(0.1)
    if #Players:GetPlayers() ~= LastPlayerCount then
        LastPlayerCount = #Players:GetPlayers()
        OnRoundChange()
    end
end)

Players.PlayerRemoving:Connect(function()
    task.wait(0.1)
    if #Players:GetPlayers() ~= LastPlayerCount then
        LastPlayerCount = #Players:GetPlayers()
        OnRoundChange()
    end
end)

